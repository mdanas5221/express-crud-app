<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Posts</title>

  <link rel="stylesheet" href="/style.css">
</head>

<body>
  <h1>Quora</h1>
  <% for( let post of posts ) { %>
  <div class="post">
    <h2>@<%= post.username %></h2>
    <h3><%= post.content %></h3>
    <br>
    <a href="http://localhost:3000/posts/<%= post.id %>">View in detail</a><br><br>
    <a href="http://localhost:3000/posts/<%= post.id %>/edit">Edit Post</a><br><br>
    <form action="/posts/<%= post.id %>?_method=DELETE" method="post">
      <button>Delete Post</button>
    </form>
  </div>
  <% } %>

  <br><br>
  <a href="http://localhost:3000/posts/new">Create New Post</a>
</body>

</html>